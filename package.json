{
  "name": "jsf-cli",
  "version": "0.1.0",
  "description": "A CLI for sharing npm package files across projects with lockfile-correct dependency trees.",
  "bin": {
    "jsf": "./bin/jsf.js"
  },
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node bin/jsf.js",
    "test": "node --test tests/unit.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.1.0",
    "p-map": "^7.0.2",
    "pacote": "^21.5.2",
    "prompts": "^2.4.2",
    "semver": "^7.6.3",
    "tar": "^7.4.3"
  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "keywords": [
    "jsf",
    "dependency-manager",
    "npm",
    "shared-store",
    "transitive-dependencies",
    "peer-dependencies",
    "cli"
  ],
  "author": "nexuss0781",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexuss0781/JSF.git"
  },
  "homepage": "https://github.com/nexuss0781/JSF#readme",
  "bugs": {
    "url": "https://github.com/nexuss0781/JSF/issues"
  }
}
